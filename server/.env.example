# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Phase 8 — MongoDB ───────────────────────────────────────────────────────
# Local development default (bundled mongod, no auth, 127.0.0.1 only).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=scs
# Fail-fast timeouts (ms) — connection + server selection.
MONGODB_TIMEOUT_MS=10000

# ── Phase 7 — sessions & cookies ────────────────────────────────────────────
# REQUIRED (≥32 chars) in production; development has a documented fallback.
SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Cookie hardening overrides (defaults: secure in production, SameSite=Lax).
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# ── Phase 8 — dev seed demo accounts (fictional, never real credentials) ───
# Documented dev-only defaults exist; override here to change them.
DEV_SEED_MEMBER_PASSWORD=
DEV_SEED_HIRA_PASSWORD=
DEV_SEED_ADMIN_PASSWORD=

# ── Phase 2 placeholders (do not fill until implemented) ────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
